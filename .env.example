# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=
# Optional PEM CA certificate for verified cloud PostgreSQL TLS (real newlines).
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEMO_AUTH_ENABLED=
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BUDGET_USD=
# Optional cloud voice for the AI student. Without a key, the browser's voice is used.
# Deepgram Aura-2 (preferred; sign-up credit, no card). English replies only.
DEEPGRAM_API_KEY=
# Optional Aura-2 English voice name, for example thalia or apollo (default thalia).
DEEPGRAM_TTS_VOICE=
# Google Cloud Text-to-Speech, Chirp 3: HD. Restrict the key to the Text-to-Speech API.
GOOGLE_TTS_API_KEY=
# Optional Chirp 3: HD voice name, for example Leda or Puck (default Leda).
GOOGLE_TTS_VOICE=
# Optional, lowers the monthly character cap (Deepgram default 1000000, max 3000000;
# Google default 900000, max 1000000).
TTS_MONTHLY_CHARACTER_CAP=
