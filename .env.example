# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=
# Optional PEM CA certificate for verified cloud PostgreSQL TLS (real newlines).
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEMO_AUTH_ENABLED=
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BUDGET_USD=
# Optional student voice (Google Cloud Text-to-Speech, Chirp 3: HD). Without a key,
# the browser's built-in voice is used. Restrict the key to the Text-to-Speech API.
GOOGLE_TTS_API_KEY=
# Optional, lowers the monthly character cap (default 900000, never above 1000000).
TTS_MONTHLY_CHARACTER_CAP=
# Optional Chirp 3: HD voice name, for example Leda or Puck (default Leda).
GOOGLE_TTS_VOICE=
